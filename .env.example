# Configuración de Entorno - Pastelería Dulces Momentos
PORT=3000

# ──────────────────────────────────────────────────────────────
# Base de Datos PostgreSQL (Neon)
# Pasos:
#   1. Entrá a https://neon.tech y creá tu proyecto
#   2. Ir a "Connection Details" → activar "Pooled connection"
#   3. Copiá la "Connection string" y pegala abajo
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST.neon.tech/dulces_momentos?sslmode=require

# ──────────────────────────────────────────────────────────────
# Seguridad JWT
# IMPORTANTE: Usá una clave larga y aleatoria en producción.
# Generá una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor NO arranca si esta variable no está definida.
# ──────────────────────────────────────────────────────────────
JWT_SECRET=cambiar_por_clave_larga_aleatoria

# ──────────────────────────────────────────────────────────────
# Correo electrónico (Nodemailer / Gmail App Password)
# Usá una contraseña de aplicación de Google, no tu contraseña normal.
# ──────────────────────────────────────────────────────────────
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion_google

# ──────────────────────────────────────────────────────────────
# Google Identity Services (OAuth 2.0)
# Obtené tu Client ID en: https://console.cloud.google.com/apis/credentials
# Debe coincidir con el GOOGLE_CLIENT_ID usado en el frontend (app.js).
# ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ──────────────────────────────────────────────────────────────
# Administradores del sistema
# Lista de correos separados por coma. Estos usuarios recibirán
# rol 'admin' en el JWT y tendrán acceso al panel de Cocina (KDS).
# ──────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@tudominio.com

# ──────────────────────────────────────────────────────────────
# Mercado Pago SDK v2
# Obtené tu Access Token en: https://www.mercadopago.com.ar/developers/panel
# ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000
